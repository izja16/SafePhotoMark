    "output_folder_hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originals are never overwritten.\nA folder named “Safe Photo Mark Output” is recommended.\nWhen Random Rename is off, file names keep the original name with a _safephotomark suffix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の写真は上書きされません。\n「Safe Photo Mark出力」というフォルダの使用をおすすめします。\n「ランダムに名前を変更」がオフのときは、ファイル名は元の名前に _safephotomark を付けたものになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본은 덮어쓰지 않습니다.\n‘Safe Photo Mark 출력’이라는 폴더를 권장합니다.\n‘무작위 이름 변경’이 꺼져 있으면 파일 이름은 원본 이름에 _safephotomark 접미사를 붙입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原图不会被覆盖。\n建议使用名为「脱敏水印输出」的文件夹。\n关闭「随机重命名」时，文件名保留原名并加上 _safephotomark 后缀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原圖不會被覆蓋。\n建議使用名為「脫敏水印輸出」的資料夾。\n關閉「隨機重新命名」時，檔名會保留原名並加上 _safephotomark 後綴。"
          }
        }
      }
