    },
    "quality_hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used for JPEG and HEIF.\nIf you choose “Same as Source” and a photo exports as one of those formats, this quality setting is used.\n16-bit and wide-gamut sources such as Display P3 are written as 8-bit sRGB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JPEG / HEIF に使用します。\n「ソースと同じ」を選び、その写真がこれらの形式で書き出される場合も、この品質が使われます。\n16 ビットや Display P3 などの広色域の元画像は、8 ビット sRGB に変換して書き出されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JPEG / HEIF에 사용됩니다.\n‘원본과 동일’을 선택했고 해당 사진이 이 형식으로 내보내지는 경우에도 이 품질이 적용됩니다.\n16비트 및 Display P3 같은 넓은 색역의 원본은 8비트 sRGB로 변환되어 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于 JPEG / HEIF。\n选择「与原图相同」时，若某张原图会导出为这两种格式，也将使用此质量。\n16 位和 Display P3 等广色域原图会转换为 8 位 sRGB 后再写出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅用於 JPEG / HEIF。\n選擇「與原圖相同」時，若某張原圖會匯出為這兩種格式，也將使用此品質。\n16 位元和 Display P3 等廣色域原圖會轉換為 8 位元 sRGB 後再寫出。"
          }
        }
      }
    },
    "random_rename" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
